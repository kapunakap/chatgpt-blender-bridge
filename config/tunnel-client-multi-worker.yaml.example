# Multi-worker variant. Replace every __PLACEHOLDER__ locally.
# Do not commit the rendered profile or tunnel credentials.

config_version: 1

admin_ui:
  open_browser: false

control_plane:
  base_url: "https://api.openai.com"
  tunnel_id: "__TUNNEL_ID__"
  api_key: "file:__RUNTIME_KEY_FILE__"

health:
  listen_addr: "127.0.0.1:0"
  url_file: "__HEALTH_URL_FILE__"

log:
  file: "__LOG_FILE__"
  format: "json"
  level: "info"

mcp:
  commands:
    - channel: "main"
      command: "/usr/bin/env CHATGPT_BLENDER_WORKER_RUNTIME=__WORKER_RUNTIME__ BLENDER_BIN=__BLENDER_BIN__ BLENDER_MCP_COMMAND=__BLENDER_MCP_COMMAND__ __BLENDER_WORKER_MCP_COMMAND__ --ensure-count 3 --base-port 9970 --worker auto"
