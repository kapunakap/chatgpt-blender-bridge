# Copy this file to .env and edit locally.
# Never commit real tunnel credentials or rendered private configs.

BLENDER_MCP_HOST=127.0.0.1
BLENDER_MCP_PORT=9876

# Verified Blender Lab MCP v1.0.0 layout. Change if your installation differs.
BLENDER_MCP_COMMAND="${HOME}/.local/share/blender-mcp/v1.0.0-venv/bin/blender-mcp"
BLENDER_MCP_PYTHON="${HOME}/.local/share/blender-mcp/v1.0.0-venv/bin/python"

# Process matching used by scripts/doctor.sh.
BLENDER_PROCESS_PATTERN=Blender
TUNNEL_PROCESS_PATTERN=tunnel-client
TUNNEL_PROFILE_NAME=blender-mcp

# Optional persistent-service checks. Change the label/path if you render the
# public examples with different local names.
TUNNEL_LAUNCHD_LABEL=com.example.chatgpt-blender-bridge
TUNNEL_HEALTH_URL_FILE="${HOME}/Library/Application Support/tunnel-client/blender-mcp.health.url"


# Optional Issue #4 multi-worker mode.
CHATGPT_BLENDER_WORKER_RUNTIME="${HOME}/.cache/chatgpt-blender-bridge/workers"
BLENDER_WORKER_COUNT=3
BLENDER_WORKER_GUI_COUNT=0
BLENDER_WORKER_BASE_PORT=9970
BLENDER_WORKER_ID=auto

# Optional Issue #7 startup project affinity.
# Leave these unset for the normal shared one-profile integration and let the
# agent call project_attach once trustworthy project/worktree metadata is known.
# BLENDER_PROJECT=Kapelica
# BLENDER_PROJECT_REPO=kapunakap/gta-labin
# BLENDER_PROJECT_BRANCH=feat/kapelica-district
# BLENDER_PROJECT_WORKTREE=/absolute/path/to/worktree
# BLENDER_PROJECT_BLEND_PATH=assets/source/city.blend
# BLENDER_PROJECT_OPEN_BLEND=0
# BLENDER_SESSION_ID=optional-stable-session-id

# Optional Issue #9 autoscaling mode.
# When enabled, set BLENDER_WORKER_COUNT=0: the user-session supervisor owns
# worker creation/termination and the tunnel-facing router only requests capacity.
BLENDER_WORKER_AUTOSCALE=0
BLENDER_WORKER_MIN_COUNT=1
BLENDER_WORKER_MAX_COUNT=5
BLENDER_WORKER_IDLE_TIMEOUT_SECONDS=1200
BLENDER_WORKER_GC_INTERVAL_SECONDS=300
BLENDER_JOB_RETENTION_SECONDS=86400
BLENDER_LOG_RETENTION_SECONDS=604800
BLENDER_PROJECT_AFFINITY_STALE_SECONDS=86400
# BLENDER_WORKER_SUPERVISOR_SOCKET="${CHATGPT_BLENDER_WORKER_RUNTIME}/supervisor.sock"
# BLENDER_WORKER_SPAWN_TIMEOUT_SECONDS=30
# BLENDER_WORKER_SUPERVISOR_TIMEOUT_SECONDS=35
