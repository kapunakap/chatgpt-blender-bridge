# Copy this file to .env and edit locally.
# Never commit real tunnel credentials.

BLENDER_MCP_HOST=127.0.0.1
BLENDER_MCP_PORT=9876

# Optional process-name override used by scripts/doctor.sh.
BLENDER_PROCESS_PATTERN=Blender

# Optional tunnel process-name/pattern override used by scripts/doctor.sh.
TUNNEL_PROCESS_PATTERN=tunnel-client
