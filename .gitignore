# Local secrets and configuration
.env
.env.*
!.env.example
*.secret
*.secrets
*.token
*.key
config/*.yaml
!config/*.example
!config/*.yaml.example
config/*.local.*

# Logs / runtime state
logs/
*.log
*.pid
*.sock

